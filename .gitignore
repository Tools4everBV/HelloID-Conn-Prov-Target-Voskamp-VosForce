# Ignore PowerShell V2 connector debug files and files generated by VSCode.

# Exclude local test/debug files, except for versioned lifecycle tests
test/*

# VSCode files (for those working on multiple projects)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local history for VSCode
.history/